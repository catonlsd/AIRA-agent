APP_NAME=AI Research Assistant
ENVIRONMENT=development

DATABASE_URL=sqlite:///./storage/research_assistant.db
VECTOR_DB_DIR=./storage/vector_index
UPLOAD_DIR=./storage/uploads

LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

WEB_SEARCH_PROVIDER=tavily
TAVILY_API_KEY=

# Embeddings + vector store
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=all-MiniLM-L6-v2
VECTOR_STORE=chroma
CHROMA_DIR=./storage/chroma

CHUNK_SIZE=1000
CHUNK_OVERLAP=150
RETRIEVAL_K=6
MEMORY_LIMIT=10

MAX_UPLOAD_SIZE_MB=10
ALLOWED_FILE_EXTENSIONS=pdf,txt,docx,md

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Optional regex for additional allowed origins (e.g. preview deploys)
CORS_ORIGIN_REGEX=https://.*\.vercel\.app

# ── Production hardening ──────────────────────────────────────────────────────
# API key auth: when set, all non-public requests must send it in API_KEY_HEADER.
# Leave blank to disable auth (local development).
API_KEY=
API_KEY_HEADER=X-API-Key

# Per-client request rate limiting (fixed 60s window).
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60

SECURITY_HEADERS_ENABLED=true
REQUEST_LOGGING_ENABLED=true